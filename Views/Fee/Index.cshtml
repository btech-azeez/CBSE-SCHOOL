@model IEnumerable<CBSESchool.Models.FeeStructure>
@{
    ViewData["Title"] = "Fee Portal & Collection";
    var classDict = ViewBag.Classes as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy"><i class="bi bi-credit-card-fill text-primary"></i> School Fee Portal & Structure</h2>
        <p class="text-muted mb-0">View tuition fees, laboratory fees, and process student fee receipts</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PayFee" class="btn btn-success fw-bold"><i class="bi bi-wallet2 me-1"></i> Record Fee Payment</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="CreateFeeStructure" class="btn btn-outline-primary fw-bold"><i class="bi bi-plus-circle-fill me-1"></i> Add Fee Item</a>
        }
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Fee Head</th>
                        <th>Applicable Class</th>
                        <th>Academic Year</th>
                        <th>Amount (INR)</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fee in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@fee.FeeType</td>
                            <td><span class="badge bg-secondary">@(classDict.ContainsKey(fee.ClassId) ? classDict[fee.ClassId] : "Class ID " + fee.ClassId)</span></td>
                            <td>@fee.AcademicYear</td>
                            <td class="fw-bold fs-6 text-success">₹ @fee.Amount.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="PayFee" asp-route-studentId="1" class="btn btn-sm btn-outline-success"><i class="bi bi-credit-card"></i> Pay Now</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
