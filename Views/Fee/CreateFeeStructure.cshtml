@model CBSESchool.Models.FeeStructure
@{
    ViewData["Title"] = "Create Fee Structure";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i> Define Fee Structure Item</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateFeeStructure" method="post">
                    <div class="mb-3">
                        <label asp-for="ClassId" class="form-label fw-bold">Class *</label>
                        <select asp-for="ClassId" asp-items="ViewBag.ClassId" class="form-select" required></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FeeType" class="form-label fw-bold">Fee Description / Head *</label>
                        <input asp-for="FeeType" class="form-control" placeholder="e.g. Tuition Fee (Quarter 1), Science Lab Fee" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label fw-bold">Fee Amount (₹) *</label>
                        <input asp-for="Amount" type="number" step="100" class="form-control" placeholder="15000" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="AcademicYear" class="form-label fw-bold">Academic Session</label>
                        <input asp-for="AcademicYear" class="form-control" value="2025-2026" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-check-circle me-1"></i> Save Fee Structure</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
