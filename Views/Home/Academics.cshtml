@{
    ViewData["Title"] = "Academics & CBSE Curriculum";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-navy text-white py-3" style="background-color: #0F2C59;">
                <h3 class="mb-0 fw-bold"><i class="bi bi-book-fill text-warning me-2"></i> CBSE Academic Curriculum & Assessment</h3>
            </div>
            <div class="card-body p-4">
                <h4 class="fw-bold text-primary mb-3">Affiliation & Educational Philosophy</h4>
                <p class="lead">Our institution follows the curriculum designed by the <strong>Central Board of Secondary Education (CBSE), New Delhi</strong>, emphasizing holistic child development, critical thinking, conceptual clarity, and continuous evaluation.</p>

                <h5 class="fw-bold text-dark mt-4">Streams Offered (Senior Secondary Class XI & XII):</h5>
                <div class="row g-3 my-2">
                    <div class="col-md-4">
                        <div class="p-3 border rounded bg-light">
                            <h6 class="fw-bold text-success"><i class="bi bi-cpu-fill me-1"></i> Science Stream</h6>
                            <ul class="small mb-0">
                                <li>Physics (042)</li>
                                <li>Chemistry (043)</li>
                                <li>Mathematics (041) / Biology (044)</li>
                                <li>Computer Science (083)</li>
                                <li>English Core (301)</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded bg-light">
                            <h6 class="fw-bold text-primary"><i class="bi bi-graph-up-arrow me-1"></i> Commerce Stream</h6>
                            <ul class="small mb-0">
                                <li>Accountancy (055)</li>
                                <li>Business Studies (054)</li>
                                <li>Economics (030)</li>
                                <li>Applied Mathematics (241)</li>
                                <li>English Core (301)</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 border rounded bg-light">
                            <h6 class="fw-bold text-danger"><i class="bi bi-palette-fill me-1"></i> Humanities / Arts</h6>
                            <ul class="small mb-0">
                                <li>History (027)</li>
                                <li>Political Science (028)</li>
                                <li>Psychology (037)</li>
                                <li>Sociology (039)</li>
                                <li>English Core (301)</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold text-dark mt-4">CBSE Continuous & Comprehensive Evaluation Scheme</h5>
                <p>Evaluation is carried out through Periodic Unit Tests, Mid-Term Examinations, Practical Science Assessments, and Board Pre-Mock Examinations based on the latest CBSE 9-point grading scheme (A1 to E).</p>
            </div>
        </div>
    </div>
</div>
