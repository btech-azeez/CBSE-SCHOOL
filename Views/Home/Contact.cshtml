@{
    ViewData["Title"] = "Contact Us";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-navy text-white py-3" style="background-color: #0F2C59;">
                <h3 class="mb-0 fw-bold"><i class="bi bi-envelope-at-fill text-warning me-2"></i> Contact & Helpdesk</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h5 class="fw-bold text-primary mb-3">School Address</h5>
                        <p class="mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i> National CBSE Public School Campus</p>
                        <p class="mb-1">Financial District, Nanakaramguda</p>
                        <p class="mb-3">Hyderabad, Telangana - 500032</p>

                        <h5 class="fw-bold text-primary mb-2">Phone & Email</h5>
                        <p class="mb-1"><i class="bi bi-telephone-fill me-2"></i> Admissions: +91 40 2345 6789</p>
                        <p class="mb-1"><i class="bi bi-envelope-fill me-2"></i> info@cbse.school.edu</p>
                    </div>

                    <div class="col-md-6">
                        <h5 class="fw-bold text-primary mb-3">Send Inquiry</h5>
                        <form>
                            <div class="mb-2">
                                <input type="text" class="form-control" placeholder="Your Full Name" required />
                            </div>
                            <div class="mb-2">
                                <input type="email" class="form-control" placeholder="Your Email Address" required />
                            </div>
                            <div class="mb-2">
                                <textarea class="form-control" rows="3" placeholder="Message or Inquiry details..."></textarea>
                            </div>
                            <button type="button" class="btn btn-navy text-white fw-bold w-100" style="background-color: #0F2C59;">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
