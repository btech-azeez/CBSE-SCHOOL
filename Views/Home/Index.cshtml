@model CBSESchool.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard & Portal Home";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0F2C59 0%, #186F65 100%);">
            <h1 class="display-6 fw-bold mb-2">Welcome to CBSE School Portal</h1>
            <p class="lead mb-3">Empowering Excellence in Education through Academic Rigor, Continuous Evaluation, and Holistic Development.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Student" asp-action="Index" class="btn btn-warning fw-bold"><i class="bi bi-people-fill me-1"></i> Manage Students</a>
                <a asp-controller="ExamMarks" asp-action="Index" class="btn btn-outline-light"><i class="bi bi-file-earmark-text me-1"></i> Exam Results</a>
                <a asp-controller="Notice" asp-action="Index" class="btn btn-outline-light"><i class="bi bi-bell-fill me-1"></i> View Announcements</a>
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-primary border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-normal mb-1">Enrolled Students</h6>
                    <h2 class="fw-bold mb-0 text-primary">@Model.TotalStudents</h2>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="bi bi-mortarboard-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-success border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-normal mb-1">Teaching Staff</h6>
                    <h2 class="fw-bold mb-0 text-success">@Model.TotalTeachers</h2>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-person-badge fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-warning border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-normal mb-1">Active Classes</h6>
                    <h2 class="fw-bold mb-0 text-warning">@Model.TotalClasses</h2>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-journal-bookmark fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-info border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-normal mb-1">Circulars / Notices</h6>
                    <h2 class="fw-bold mb-0 text-info">@Model.ActiveNoticesCount</h2>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="bi bi-megaphone fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Notice Board Column -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-pin-angle-fill text-danger me-2"></i> Latest CBSE Announcements</h5>
                <a asp-controller="Notice" asp-action="Index" class="btn btn-sm btn-link">View All Notices &rarr;</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var notice in Model.RecentNotices)
                    {
                        <div class="list-group-item p-3">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <h6 class="mb-1 fw-bold text-primary">
                                    @if (notice.IsImportant)
                                    {
                                        <span class="badge bg-danger me-1">IMPORTANT</span>
                                    }
                                    @notice.Title
                                </h6>
                                <small class="text-muted"><i class="bi bi-calendar-event"></i> @notice.PostDate.ToString("dd MMM yyyy")</small>
                            </div>
                            <p class="mb-1 text-secondary small">@notice.Content</p>
                            <small class="text-muted">Target Audience: <span class="badge bg-secondary">@notice.TargetRole</span> | Posted by: <strong>@notice.PostedBy</strong></small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action Cards & Demo Login Info -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-lightning-charge-fill text-warning me-2"></i> Portal Demo Accounts</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-light border mb-2">
                    <strong>Admin Login:</strong> <code>admin@cbse.school.edu</code> / <code>Admin@123</code>
                </div>
                <div class="alert alert-light border mb-2">
                    <strong>Teacher Login:</strong> <code>rajesh.sharma@cbse.school.edu</code> / <code>Teacher@123</code>
                </div>
                <div class="alert alert-light border mb-0">
                    <strong>Student Login:</strong> <code>aarav.gupta@cbse.school.edu</code> / <code>Student@123</code>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-gear-wide-connected text-primary me-2"></i> Quick Management Links</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Student" asp-action="Create" class="btn btn-outline-primary text-start"><i class="bi bi-person-plus-fill me-2"></i> Enroll New Student</a>
                    <a asp-controller="ExamMarks" asp-action="CreateExam" class="btn btn-outline-success text-start"><i class="bi bi-plus-circle-fill me-2"></i> Schedule CBSE Exam</a>
                    <a asp-controller="ExamMarks" asp-action="EnterMarks" class="btn btn-outline-info text-start"><i class="bi bi-pencil-square me-2"></i> Enter / Evaluate Student Marks</a>
                    <a asp-controller="Notice" asp-action="Create" class="btn btn-outline-secondary text-start"><i class="bi bi-megaphone-fill me-2"></i> Post New Announcement</a>
                    <a asp-controller="Fee" asp-action="PayFee" class="btn btn-outline-warning text-start text-dark"><i class="bi bi-credit-card-2-front-fill me-2"></i> Collect Fee Payment</a>
                </div>
            </div>
        </div>
    </div>
</div>
