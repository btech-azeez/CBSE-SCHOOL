@{
    ViewData["Title"] = "Campus & Infrastructure Facilities";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-navy text-white py-3" style="background-color: #0F2C59;">
                <h3 class="mb-0 fw-bold"><i class="bi bi-building-fill text-warning me-2"></i> Campus Facilities & Infrastructure</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-laptop fs-1 text-primary me-3"></i>
                            <div>
                                <h5 class="fw-bold">Smart Classrooms & Computer Labs</h5>
                                <p class="text-muted">High-speed internet connected IT labs equipped with modern PCs, interactive whiteboards, and digital learning modules.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-beaker fs-1 text-success me-3"></i>
                            <div>
                                <h5 class="fw-bold">Science & Mathematics Laboratories</h5>
                                <p class="text-muted">Advanced Physics, Chemistry, Biology, and Math laboratories fully compliant with CBSE practical curriculum standards.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-book fs-1 text-warning me-3"></i>
                            <div>
                                <h5 class="fw-bold">Comprehensive Library</h5>
                                <p class="text-muted">Over 15,000 reference books, national journals, competitive exam resources (JEE/NEET/CUET), and digital e-books.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-trophy fs-1 text-danger me-3"></i>
                            <div>
                                <h5 class="fw-bold">Sports & Athletic Complex</h5>
                                <p class="text-muted">Standard basketball court, cricket practice nets, football ground, indoor badminton court, and yoga pavilion.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
