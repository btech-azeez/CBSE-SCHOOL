@model CBSESchool.Models.Notice
@{
    ViewData["Title"] = "Delete Notice";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-trash-fill me-2"></i> Delete Notice</h5>
            </div>
            <div class="card-body p-4 text-center">
                <p class="lead">Are you sure you want to delete this notice?</p>
                <div class="alert alert-light border">
                    <h5 class="fw-bold">@Model.Title</h5>
                    <p class="small text-muted">@Model.Content</p>
                </div>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">Delete Notice</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
