@model IEnumerable<CBSESchool.Models.Notice>
@{
    ViewData["Title"] = "Circulars & Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy"><i class="bi bi-megaphone-fill text-danger"></i> Circulars & Official Announcements</h2>
        <p class="text-muted mb-0">CBSE examination circulars, events, and school administrative notices</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
    {
        <div>
            <a asp-action="Create" class="btn btn-danger fw-bold"><i class="bi bi-plus-circle-fill me-1"></i> Post Announcement</a>
        </div>
    }
</div>

<div class="row g-3">
    @foreach (var notice in Model)
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 border-start border-4 @(notice.IsImportant ? "border-danger" : "border-primary")">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="fw-bold text-dark mb-0">
                            @if (notice.IsImportant)
                            {
                                <span class="badge bg-danger me-2"><i class="bi bi-exclamation-octagon-fill me-1"></i> URGENT</span>
                            }
                            @notice.Title
                        </h4>
                        <span class="badge bg-light text-dark border"><i class="bi bi-calendar-event me-1"></i> @notice.PostDate.ToString("dd MMMM yyyy")</span>
                    </div>
                    <p class="card-text text-secondary mb-3 fs-6">@notice.Content</p>
                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                        <small class="text-muted">Target Group: <span class="badge bg-info text-dark">@notice.TargetRole</span> | Posted by: <strong>@notice.PostedBy</strong></small>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@notice.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
