@model IEnumerable<CBSESchool.Models.Exam>
@{
    ViewData["Title"] = "CBSE Examinations & Assessment";
    var classDict = ViewBag.Classes as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy"><i class="bi bi-file-earmark-spreadsheet-fill text-info"></i> CBSE Examinations & Grading Portal</h2>
        <p class="text-muted mb-0">Schedule exams, enter evaluation marks, and issue CBSE official report cards</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
    {
        <div>
            <a asp-action="CreateExam" class="btn btn-info text-white fw-bold"><i class="bi bi-calendar-plus-fill me-1"></i> Schedule Exam</a>
        </div>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Examination Title</th>
                        <th>Academic Year</th>
                        <th>Class</th>
                        <th>Exam Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exam in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@exam.ExamName</td>
                            <td><span class="badge bg-secondary">@exam.AcademicYear</span></td>
                            <td><span class="badge bg-primary">@(classDict.ContainsKey(exam.ClassId) ? classDict[exam.ClassId] : "Class ID " + exam.ClassId)</span></td>
                            <td><i class="bi bi-calendar-event me-1 text-muted"></i> @exam.ExamDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EnterMarks" asp-route-examId="@exam.Id" class="btn btn-outline-success"><i class="bi bi-pencil-square me-1"></i> Marks Entry</a>
                                    <a asp-action="ReportCard" asp-route-studentId="1" asp-route-examId="@exam.Id" class="btn btn-outline-primary"><i class="bi bi-award-fill me-1"></i> Sample Report Card</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
