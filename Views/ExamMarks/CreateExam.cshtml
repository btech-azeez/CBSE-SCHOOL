@model CBSESchool.Models.Exam
@{
    ViewData["Title"] = "Schedule Exam";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-plus-fill me-2"></i> Schedule New Examination</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateExam" method="post">
                    <div class="mb-3">
                        <label asp-for="ExamName" class="form-label fw-bold">Exam Name *</label>
                        <input asp-for="ExamName" class="form-control" placeholder="e.g. Mid-Term Examination 2025" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AcademicYear" class="form-label fw-bold">Academic Year</label>
                        <input asp-for="AcademicYear" class="form-control" value="2025-2026" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClassId" class="form-label fw-bold">Class *</label>
                        <select asp-for="ClassId" asp-items="ViewBag.ClassId" class="form-select" required></select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ExamDate" class="form-label fw-bold">Exam Commencement Date</label>
                        <input asp-for="ExamDate" type="date" class="form-control" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                        <button type="submit" class="btn btn-info text-white fw-bold"><i class="bi bi-check-circle me-1"></i> Save Schedule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
