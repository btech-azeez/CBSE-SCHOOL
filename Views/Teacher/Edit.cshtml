@model CBSESchool.Models.Teacher
@{
    ViewData["Title"] = "Edit Faculty Record";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Faculty: @Model.FullName</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="JoiningDate" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EmployeeCode" class="form-label fw-bold">Employee Code</label>
                            <input asp-for="EmployeeCode" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name *</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Qualification" class="form-label fw-bold">Qualification</label>
                            <input asp-for="Qualification" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SpecializationSubject" class="form-label fw-bold">Specialization</label>
                            <input asp-for="SpecializationSubject" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                        <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="bi bi-save me-1"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
