@model CBSESchool.Models.Teacher
@{
    ViewData["Title"] = "Faculty Details - " + Model.FullName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2"></i> Faculty Profile</h5>
                <span class="badge bg-light text-dark fs-6">@Model.EmployeeCode</span>
            </div>
            <div class="card-body p-4">
                <h3 class="fw-bold text-success">@Model.FullName</h3>
                <p class="text-muted"><span class="badge bg-success">@Model.SpecializationSubject Specialist</span></p>

                <div class="row g-3 my-3">
                    <div class="col-md-6"><strong>Qualification:</strong> @Model.Qualification</div>
                    <div class="col-md-6"><strong>Email:</strong> @Model.Email</div>
                    <div class="col-md-6"><strong>Phone:</strong> @Model.Phone</div>
                    <div class="col-md-6"><strong>Joining Date:</strong> @Model.JoiningDate.ToString("dd MMMM yyyy")</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Directory</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Edit Record</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
