@model CBSESchool.Models.Teacher
@{
    ViewData["Title"] = "Add Faculty Member";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i> Register New Faculty Member</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EmployeeCode" class="form-label fw-bold">Employee Code (Optional - Auto Generated)</label>
                            <input asp-for="EmployeeCode" class="form-control" placeholder="e.g. EMP-T-103" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name *</label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Dr. Rajesh Sharma" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Qualification" class="form-label fw-bold">Qualification</label>
                            <input asp-for="Qualification" class="form-control" placeholder="e.g. M.Sc, Ph.D, B.Ed" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SpecializationSubject" class="form-label fw-bold">Subject Specialization *</label>
                            <input asp-for="SpecializationSubject" class="form-control" placeholder="e.g. Mathematics, Physics" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">Email Address *</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="teacher@cbse.school.edu" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="Phone" class="form-control" placeholder="+91 9876543210" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-check-circle me-1"></i> Register Faculty</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
