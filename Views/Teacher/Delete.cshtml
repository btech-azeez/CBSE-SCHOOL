@model CBSESchool.Models.Teacher
@{
    ViewData["Title"] = "Delete Faculty Record";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Faculty Deletion</h5>
            </div>
            <div class="card-body p-4 text-center">
                <p class="lead">Are you sure you want to remove faculty record for <strong>@Model.FullName</strong>?</p>
                <div class="alert alert-light border">
                    <div><strong>Code:</strong> @Model.EmployeeCode</div>
                    <div><strong>Subject:</strong> @Model.SpecializationSubject</div>
                </div>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold"><i class="bi bi-trash-fill me-1"></i> Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
