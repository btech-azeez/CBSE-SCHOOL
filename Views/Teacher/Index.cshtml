@model IEnumerable<CBSESchool.Models.Teacher>
@{
    ViewData["Title"] = "Faculty & Teaching Staff";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy"><i class="bi bi-person-badge-fill text-success"></i> Faculty & Staff Directory</h2>
        <p class="text-muted mb-0">CBSE Subject Teachers & Faculty Members</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div>
            <a asp-action="Create" class="btn btn-success fw-bold"><i class="bi bi-plus-circle-fill me-1"></i> Add Faculty Member</a>
        </div>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Employee Code</th>
                        <th>Faculty Name</th>
                        <th>Qualification</th>
                        <th>Specialization</th>
                        <th>Email & Contact</th>
                        <th>Joining Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var teacher in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark fs-6">@teacher.EmployeeCode</span></td>
                            <td class="fw-bold">@teacher.FullName</td>
                            <td>@teacher.Qualification</td>
                            <td><span class="badge bg-success">@teacher.SpecializationSubject</span></td>
                            <td>
                                <div><i class="bi bi-envelope-fill text-muted"></i> @teacher.Email</div>
                                <small class="text-muted"><i class="bi bi-telephone-fill"></i> @teacher.Phone</small>
                            </td>
                            <td>@teacher.JoiningDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-outline-info"><i class="bi bi-eye"></i> Details</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@teacher.Id" class="btn btn-outline-warning"><i class="bi bi-pencil"></i> Edit</a>
                                        <a asp-action="Delete" asp-route-id="@teacher.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
