@model CBSESchool.Models.Subject
@{
    ViewData["Title"] = "Create CBSE Subject Code";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-book-half me-2"></i> Add CBSE Subject</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateSubject" method="post">
                    <div class="mb-3">
                        <label asp-for="SubjectCode" class="form-label fw-bold">CBSE Subject Code *</label>
                        <input asp-for="SubjectCode" class="form-control" placeholder="e.g. 041, 042, 301" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="SubjectName" class="form-label fw-bold">Subject Name *</label>
                        <input asp-for="SubjectName" class="form-control" placeholder="e.g. Mathematics, Physics" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClassId" class="form-label fw-bold">Applicable Class *</label>
                        <select asp-for="ClassId" asp-items="ViewBag.ClassId" class="form-select" required></select>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="PassMarks" class="form-label fw-bold">Pass Marks</label>
                            <input asp-for="PassMarks" type="number" class="form-control" value="33" />
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="MaxMarks" class="form-label fw-bold">Max Marks</label>
                            <input asp-for="MaxMarks" type="number" class="form-control" value="100" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-check-circle me-1"></i> Add Subject</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
