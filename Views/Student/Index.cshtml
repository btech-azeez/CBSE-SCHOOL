@model IEnumerable<CBSESchool.Models.Student>
@{
    ViewData["Title"] = "Student Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-navy"><i class="bi bi-people-fill text-primary"></i> CBSE Student Directory</h2>
        <p class="text-muted mb-0">Manage student enrollment, roll numbers, and personal details</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-bold"><i class="bi bi-person-plus-fill me-1"></i> Enroll Student</a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4 p-3 bg-white">
    <form method="get" asp-action="Index" class="row g-3">
        <div class="col-md-4">
            <label class="form-label fw-bold small text-uppercase">Filter by Class</label>
            <select name="classId" asp-items="ViewBag.Classes" class="form-select">
                <option value="">-- All Classes --</option>
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label fw-bold small text-uppercase">Search Name or Roll No</label>
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search by name or CBSE Roll No..." />
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-search me-1"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Student Grid Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>CBSE Roll No</th>
                        <th>Student Name</th>
                        <th>Gender</th>
                        <th>Class</th>
                        <th>Parent Contact</th>
                        <th>Enrollment Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No student records found matching search criteria.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td><span class="badge bg-primary fs-6">@student.RollNumber</span></td>
                                <td class="fw-bold">@student.FullName</td>
                                <td>@student.Gender</td>
                                <td><span class="badge bg-secondary">@(student.SchoolClass?.ClassName ?? "Class ID: " + student.ClassId)</span></td>
                                <td>
                                    <div><i class="bi bi-person-fill text-muted"></i> @student.ParentName</div>
                                    <small class="text-muted"><i class="bi bi-telephone-fill"></i> @student.ParentContact</small>
                                </td>
                                <td>@student.EnrollmentDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-info" title="View Profile"><i class="bi bi-eye"></i> Profile</a>
                                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-warning" title="Edit Student"><i class="bi bi-pencil"></i> Edit</a>
                                        <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger" title="Delete Student"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
