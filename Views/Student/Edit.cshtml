@model CBSESchool.Models.Student
@{
    ViewData["Title"] = "Edit Student Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Edit Student: @Model.FullName</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="EnrollmentDate" />
                    <input type="hidden" asp-for="UserId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RollNumber" class="form-label fw-bold">CBSE Roll Number</label>
                            <input asp-for="RollNumber" class="form-control" required />
                            <span asp-validation-for="RollNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name *</label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClassId" class="form-label fw-bold">Class & Section *</label>
                            <select asp-for="ClassId" asp-items="ViewBag.ClassId" class="form-select" required></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-bold">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-bold">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ParentName" class="form-label fw-bold">Parent Name</label>
                            <input asp-for="ParentName" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ParentContact" class="form-label fw-bold">Parent Contact</label>
                            <input asp-for="ParentContact" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ParentEmail" class="form-label fw-bold">Parent Email</label>
                            <input asp-for="ParentEmail" type="email" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-bold">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
                        <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="bi bi-save me-1"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
