@model CBSESchool.Models.Student
@{
    ViewData["Title"] = "Student Profile - " + Model.FullName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-navy text-white py-3 d-flex justify-content-between align-items-center" style="background-color: #0F2C59;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2"></i> CBSE Student Profile</h5>
                <span class="badge bg-warning text-dark fs-6">Roll: @Model.RollNumber</span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-md-3 text-center mb-3 mb-md-0">
                        <div class="p-4 bg-light rounded-circle d-inline-block border">
                            <i class="bi bi-person-fill text-secondary display-3"></i>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <h3 class="fw-bold text-navy">@Model.FullName</h3>
                        <p class="text-muted mb-2"><i class="bi bi-mortarboard-fill me-1"></i> Class: <strong>@(Model.SchoolClass?.ClassName ?? "Class ID " + Model.ClassId)</strong> (Section @(Model.SchoolClass?.Section ?? "A"))</p>
                        <p class="text-muted mb-0"><i class="bi bi-calendar-check me-1"></i> Enrolled: <strong>@Model.EnrollmentDate.ToString("dd MMMM yyyy")</strong></p>
                    </div>
                </div>

                <h6 class="fw-bold text-uppercase border-bottom pb-2 text-primary">Personal Details</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("dd MMM yyyy")
                    </div>
                    <div class="col-md-6">
                        <strong>Gender:</strong> @Model.Gender
                    </div>
                </div>

                <h6 class="fw-bold text-uppercase border-bottom pb-2 text-primary">Parent / Guardian Contact Information</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <strong>Parent Name:</strong> @Model.ParentName
                    </div>
                    <div class="col-md-6">
                        <strong>Contact Phone:</strong> @Model.ParentContact
                    </div>
                    <div class="col-md-6">
                        <strong>Email Address:</strong> @(string.IsNullOrEmpty(Model.ParentEmail) ? "N/A" : Model.ParentEmail)
                    </div>
                    <div class="col-md-6">
                        <strong>Residential Address:</strong> @Model.Address
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Directory</a>
                    <div>
                        <a asp-controller="ExamMarks" asp-action="ReportCard" asp-route-studentId="@Model.Id" asp-route-examId="1" class="btn btn-info me-2 text-white"><i class="bi bi-file-earmark-spreadsheet me-1"></i> View Report Card</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Edit Profile</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
