@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5 text-center">
    <div class="col-md-6">
        <div class="card shadow-sm p-5 border-0">
            <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
            <h2 class="fw-bold text-danger">Access Restricted</h2>
            <p class="lead text-muted">You do not have the required permissions or role to view this CBSE portal page.</p>
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4"><i class="bi bi-house-fill me-1"></i> Return to Home</a>
            </div>
        </div>
    </div>
</div>
