@model CBSESchool.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "User Login";
}

<div class="row justify-content-center my-4">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-header bg-navy text-white text-center py-4" style="background-color: #0F2C59;">
                <i class="bi bi-shield-lock-fill fs-1 text-warning"></i>
                <h4 class="fw-bold mb-0 mt-2">CBSE Portal Login</h4>
                <p class="small text-light mb-0">Sign in to access your dashboard</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label font-weight-bold"><i class="bi bi-envelope-fill text-muted"></i> Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="name@cbse.school.edu" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label font-weight-bold"><i class="bi bi-key-fill text-muted"></i> Password</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted">Remember me on this browser</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="background-color: #0F2C59; border: none;">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <hr class="my-4" />

                <div class="text-center">
                    <p class="mb-0 text-muted small">Don't have an account? <a asp-action="Register" class="fw-bold text-primary">Register Here</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
